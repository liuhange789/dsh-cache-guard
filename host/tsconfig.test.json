{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-test",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}